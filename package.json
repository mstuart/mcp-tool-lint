{
  "name": "mcp-tool-lint",
  "version": "0.1.0",
  "description": "Static linter for MCP tool definitions — catch quality defects before deployment",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "linting",
    "tools",
    "ai",
    "claude"
  ],
  "homepage": "https://github.com/mstuart/mcp-tool-lint#readme",
  "bugs": {
    "url": "https://github.com/mstuart/mcp-tool-lint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mstuart/mcp-tool-lint.git"
  },
  "license": "MIT",
  "author": "Mark Stuart <742884+mstuart@users.noreply.github.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-tool-lint": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "pack:check": "npm pack --dry-run",
    "test": "tsc && node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "ultracite": "7.10.2"
  },
  "engines": {
    "node": ">=18"
  }
}
